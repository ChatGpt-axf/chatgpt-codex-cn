# Active site configuration.
SITE_ID=chatgpt-codex-cn
SITE_URL=

# Prelaunch policy. Keep indexing and live submissions disabled until a real
# production domain, webmaster verification, and Cloudflare project are ready.
PREVIEW_MODE=true
PRODUCTION_ENABLED=false
NOINDEX=true

# IndexNow. Never commit the real key.
INDEXNOW_KEY=
INDEXNOW_ENDPOINT=https://api.indexnow.org/indexnow
INDEXNOW_KEY_LOCATION=

# Baidu ordinary inclusion API. Fill these only after site verification.
BAIDU_SITE=
BAIDU_TOKEN=
BAIDU_ENDPOINT=https://data.zz.baidu.com/urls
BAIDU_FAST_ENDPOINT=
