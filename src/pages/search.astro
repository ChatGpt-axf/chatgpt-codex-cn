---
import PageLayout from '../layouts/PageLayout.astro';
import { siteConfig } from '../config/site';
import { contentPath, getPublishedContent } from '../utils/content';
const entries = (await getPublishedContent()).map((entry) => ({
  title: entry.data.title,
  description: entry.data.description,
  url: contentPath(entry),
  text: [entry.data.title, entry.data.description, ...entry.data.keywords, ...entry.data.tags].join(' ').toLowerCase(),
}));
---
{siteConfig.features.search ? (
  <PageLayout title="搜索知识库" description={`搜索${siteConfig.site.name}中的实用指南、产品对比、核心概念、常见问题与故障排查内容，快速定位相关主题。`} path="/search/" noindex={true}>
    <form class="search-form" role="search"><label for="q">输入主题或问题</label><div><input id="q" name="q" type="search" autocomplete="off" /><button type="submit">搜索</button></div></form>
    <p id="search-status" aria-live="polite">输入关键词开始搜索。</p><div id="search-results"></div>
    <script is:inline define:vars={{ entries }}>
      const form = document.querySelector('.search-form');
      const input = document.querySelector('#q');
      const results = document.querySelector('#search-results');
      const status = document.querySelector('#search-status');
      const render = (query) => {
        const normalized = query.trim().toLowerCase();
        const matched = normalized ? entries.filter((entry) => entry.text.includes(normalized)).slice(0, 20) : [];
        status.textContent = normalized ? `找到 ${matched.length} 条结果` : '输入关键词开始搜索。';
        results.replaceChildren(...matched.map((entry) => {
          const article = document.createElement('article');
          const title = document.createElement('h2');
          const link = document.createElement('a');
          const description = document.createElement('p');
          link.href = entry.url; link.textContent = entry.title; title.append(link);
          description.textContent = entry.description; article.append(title, description); return article;
        }));
      };
      form.addEventListener('submit', (event) => { event.preventDefault(); render(input.value); history.replaceState(null, '', input.value ? `?q=${encodeURIComponent(input.value)}` : location.pathname); });
      const initial = new URLSearchParams(location.search).get('q') || ''; input.value = initial; render(initial);
    </script>
  </PageLayout>
) : <PageLayout title="搜索未启用" description="当前站点配置未启用站内搜索，请通过主导航浏览公开内容。" path="/search/" noindex={true}><p>请通过主导航浏览内容。</p></PageLayout>}
<style>
  .search-form label { display: block; margin-bottom: 8px; font-weight: 750; }
  .search-form div { display: grid; grid-template-columns: 1fr auto; gap: 8px; }
  input { min-width: 0; padding: 11px 12px; border: 1px solid var(--color-border); border-radius: 6px; background: white; }
  button { padding: 10px 18px; border: 0; border-radius: 6px; background: var(--color-primary); color: white; cursor: pointer; font-weight: 750; }
  #search-status { color: var(--color-muted); }
  #search-results article { padding: 18px 0; border-bottom: 1px solid var(--color-border); }
  #search-results h2 { margin: 0; font-size: 1.18rem; } #search-results h2 a { color: var(--color-text); text-decoration: none; }
  #search-results p { margin: 5px 0 0; color: var(--color-muted); }
</style>
