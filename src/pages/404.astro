---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBasePath } from '../utils/url';
---
<BaseLayout title="页面未找到" description="你访问的页面不存在、已移动或地址有误。当前站点内容已清空并正在重新整理，请返回首页等待新的内容规划上线。" canonicalPath="/404/" noindex={true}>
  <div class="container not-found">
    <span>404</span><h1>页面未找到</h1><p>这个地址可能已变更。当前站点内容正在重新整理，请先返回首页。</p>
    <div class="actions"><a href={withBasePath('/')}>返回首页</a></div>
  </div>
</BaseLayout>
<style>
  .not-found { max-width: 760px; padding-block: 80px; text-align: center; }
  .not-found > span { color: var(--color-primary); font-size: 1.2rem; font-weight: 850; }
  h1 { margin: 6px 0; font-size: clamp(2.4rem, 8vw, 4.5rem); } p { color: var(--color-muted); }
  .actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; margin-top: 24px; }
  .actions a { padding: 10px 16px; border-radius: 6px; background: var(--color-primary); color: white; font-weight: 750; text-decoration: none; }
</style>
