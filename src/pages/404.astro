---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../config/site';
import { getPublishedContent, contentPath } from '../utils/content';
import { withBasePath } from '../utils/url';
const popular = (await getPublishedContent()).filter((entry) => entry.data.featured).slice(0, 4);
---
<BaseLayout title="页面未找到" description="你访问的页面不存在、已移动或地址有误，可返回首页、浏览核心栏目或搜索知识库。" canonicalPath="/404/" noindex={true}>
  <div class="container not-found">
    <span>404</span><h1>页面未找到</h1><p>这个地址可能已变更。你可以从核心栏目继续，或返回首页重新查找。</p>
    <div class="actions"><a href={withBasePath('/')}>返回首页</a>{siteConfig.features.search && <a href={withBasePath('/search/')}>搜索内容</a>}</div>
    <nav aria-label="核心栏目">{siteConfig.navigation.header.slice(1).map((item) => <a href={withBasePath(item.url)}>{item.label}</a>)}</nav>
    {popular.length > 0 && <section><h2>热门内容</h2><ul>{popular.map((entry) => <li><a href={contentPath(entry)}>{entry.data.title}</a></li>)}</ul></section>}
  </div>
</BaseLayout>
<style>
  .not-found { max-width: 760px; padding-block: 80px; text-align: center; }
  .not-found > span { color: var(--color-primary); font-size: 1.2rem; font-weight: 850; }
  h1 { margin: 6px 0; font-size: clamp(2.4rem, 8vw, 4.5rem); } p { color: var(--color-muted); }
  .actions, nav { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; margin-top: 24px; }
  .actions a { padding: 10px 16px; border-radius: 6px; background: var(--color-primary); color: white; font-weight: 750; text-decoration: none; }
  nav a { color: var(--color-secondary); } section { margin-top: 48px; text-align: left; }
</style>
