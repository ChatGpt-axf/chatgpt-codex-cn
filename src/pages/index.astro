---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../config/site';
import { COLLECTION_LABELS, contentPath, getPublishedContent, type AnyContentEntry } from '../utils/content';
import { faqSchema, organizationSchema, webPageSchema, websiteSchema } from '../seo/schema';
import { withBasePath } from '../utils/url';

const entries = await getPublishedContent();
const contentByKey = new Map<string, AnyContentEntry>(
  entries.map((entry) => [`${entry.collection}/${entry.data.slug}`, entry]),
);
const pickArticles = (keys: string[]) => keys
  .map((key) => contentByKey.get(key))
  .filter((entry): entry is AnyContentEntry => Boolean(entry));

const coreArticles = pickArticles([
  'concepts/what-is-codex',
  'comparisons/chatgpt-plus-vs-pro',
  'guides/chatgpt-plus-subscribe-cn',
  'problems/codex-usage-limits',
  'guides/chatgpt-plus-guide',
]);

const quickEntries = [
  {
    title: 'ChatGPT',
    description: '从基础使用、Plus 订阅准备到常见问题，按真实任务快速找到可执行的中文指南。',
    path: '/chatgpt/',
    cta: '查看 ChatGPT 指南',
    articles: pickArticles(['guides/chatgpt-plus-guide', 'guides/chatgpt-plus-subscribe-cn']),
  },
  {
    title: 'Plus / Pro',
    description: '比较 Plus 与 Pro 的适用人群、使用强度和典型场景，避免只凭价格做选择。',
    path: '/comparisons/',
    cta: '查看版本对比',
    articles: pickArticles(['comparisons/chatgpt-plus-vs-pro', 'guides/chatgpt-plus-guide']),
  },
  {
    title: 'Codex',
    description: '面向开发者的 Codex 概念解释、额度问题、仓库工作流和故障排查入口。',
    path: '/codex/',
    cta: '查看 Codex 指南',
    articles: pickArticles(['concepts/what-is-codex', 'problems/codex-usage-limits']),
  },
];

const advantages = [
  {
    icon: '中',
    title: '中文实用教程',
    description: '用中文把订阅准备、功能使用、错误排查和日常工作流讲清楚。',
  },
  {
    icon: '比',
    title: '版本选择对比',
    description: '围绕 Plus、Pro、Codex 的真实使用场景给出选择思路。',
  },
  {
    icon: '{ }',
    title: 'Codex 开发指南',
    description: '面向开发者梳理 Codex 适合的任务、限制和使用节奏。',
  },
  {
    icon: '?',
    title: '常见问题排查',
    description: '把支付、额度、订阅状态和使用问题整理成可检索的解决路径。',
  },
];

const versionCards = [
  {
    title: 'ChatGPT Plus',
    subtitle: '适合日常 AI 使用',
    audience: '学生、职场用户、内容创作者和中轻度 AI 使用者。',
    scenario: '日常问答、写作、总结、学习、办公和轻量工具调用。',
    path: '/guides/chatgpt-plus-guide/',
  },
  {
    title: 'ChatGPT Pro',
    subtitle: '适合高频和重度用户',
    audience: '需要更高使用强度、长期依赖 ChatGPT 工作的人。',
    scenario: '高频研究、复杂任务、多轮推理、长时间生产力工作流。',
    path: '/comparisons/chatgpt-plus-vs-pro/',
  },
  {
    title: 'Codex',
    subtitle: '适合编程与开发工作流',
    audience: '开发者、技术团队、独立产品构建者和 AI 编程用户。',
    scenario: '代码理解、仓库修改、问题定位、自动化开发辅助。',
    path: '/concepts/what-is-codex/',
  },
];

const preparationNotes = [
  '使用自己的长期账号',
  '确认当前订阅状态',
  '不要泄露密码和验证码',
  '保存订单记录',
  '先确认 Plus / Pro / Codex 的区别',
];

const homeFaq = [
  {
    question: 'ChatGPT Plus 和 Pro 有什么区别？',
    answer: '可以先按使用频率和任务强度判断。Plus 更适合日常使用，Pro 更适合高频、重度和复杂任务用户；具体差异建议查看版本对比指南。',
  },
  {
    question: '国内用户如何订阅 ChatGPT？',
    answer: '建议先确认账号、订阅状态、支付准备和安全注意事项，再进入订阅流程。本站提供订阅前检查清单和常见问题说明。',
  },
  {
    question: 'Codex 适合哪些开发者？',
    answer: 'Codex 更适合需要处理代码仓库、理解项目上下文、定位问题和辅助开发的用户，尤其适合已经有明确开发任务的人。',
  },
  {
    question: 'Codex 额度不足怎么办？',
    answer: '优先检查当前任务是否过大、是否可以拆分、是否存在重复执行，再根据账号权益和使用节奏决定是否调整方案。',
  },
  {
    question: '已有 Plus 是否需要升级 Pro？',
    answer: '如果只是日常问答、写作和轻量办公，通常先用 Plus 评估即可；如果长期高频使用或经常遇到能力、额度、任务复杂度限制，再考虑 Pro。',
  },
];

const schemas: Array<Record<string, unknown>> = [
  websiteSchema(),
  organizationSchema(),
  webPageSchema({ title: siteConfig.seo.defaultTitle, description: siteConfig.seo.defaultDescription, path: '/' }),
  faqSchema(homeFaq),
];
const heroImage = `url("${withBasePath(siteConfig.seo.defaultOgImage)}")`;
---

<BaseLayout
  title={siteConfig.seo.defaultTitle}
  description={siteConfig.seo.defaultDescription}
  canonicalPath="/"
  schema={schemas}
>
  <section class="hero" style={`--hero-image: ${heroImage}`}>
    <div class="container hero-grid">
      <div class="hero-copy">
        <span class="hero-kicker">中文教程 · 版本对比 · 开发者指南</span>
        <h1><span>ChatGPT &amp; Codex</span><span>中文指南</span></h1>
        <p>
          面向中文用户的 ChatGPT、ChatGPT Plus、ChatGPT Pro、Codex 与 AI 工具实用指南。
          提供版本对比、订阅准备、额度问题、开发者指南和常见故障解决。
        </p>
        <div class="hero-actions">
          <a class="btn btn-primary" href={siteConfig.site.conversionUrl} target="_blank" rel="noopener noreferrer">订阅 / 升级</a>
          <a class="btn btn-light" href={withBasePath('/guides/')}>浏览实用指南</a>
          {siteConfig.features.search && <a class="btn btn-ghost" href={withBasePath('/search/')}>搜索知识库</a>}
        </div>
        <ul class="trust-list" aria-label="站点特点">
          <li>中文指南</li>
          <li>持续更新</li>
          <li>版本对比</li>
          <li>开发者教程</li>
        </ul>
      </div>
      <div class="hero-panel" aria-label="核心内容入口">
        <div>
          <span>重点主题</span>
          <strong>Plus / Pro / Codex</strong>
        </div>
        <div>
          <span>内容类型</span>
          <strong>教程、对比、问题解决</strong>
        </div>
        <div>
          <span>适用用户</span>
          <strong>新手、订阅用户、开发者</strong>
        </div>
      </div>
    </div>
  </section>

  <section class="section quick-section">
    <div class="container">
      <div class="section-heading compact-heading">
        <div>
          <span class="eyebrow">Quick Entry</span>
          <h2>快速进入你关心的主题</h2>
        </div>
        <p>先选主题，再看指南。每个入口都连接到对应 Topic Cluster，方便继续阅读相关教程。</p>
      </div>
      <div class="quick-grid">
        {quickEntries.map((item) => (
          <article class="quick-card">
            <div>
              <h3>{item.title}</h3>
              <p>{item.description}</p>
            </div>
            <a class="card-action" href={withBasePath(item.path)}>{item.cta}</a>
            {item.articles.length > 0 && (
              <div class="hot-links">
                <span>热门文章</span>
                <ul>
                  {item.articles.map((article) => (
                    <li><a href={contentPath(article)}>{article.data.title}</a></li>
                  ))}
                </ul>
              </div>
            )}
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section advantages-section">
    <div class="container">
      <div class="section-heading center-heading">
        <span class="eyebrow">Why This Guide</span>
        <h2>为什么使用 ChatGPT &amp; Codex 中文指南</h2>
      </div>
      <div class="advantage-grid">
        {advantages.map((item) => (
          <article class="advantage-card">
            <span class="icon" aria-hidden="true">{item.icon}</span>
            <h3>{item.title}</h3>
            <p>{item.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section process-section">
    <div class="container">
      <div class="section-heading compact-heading">
        <div>
          <span class="eyebrow">Process</span>
          <h2>三步开始使用 ChatGPT</h2>
        </div>
        <p>先明确需求，再处理订阅，最后回到指南继续学习具体用法。</p>
      </div>
      <div class="process-grid">
        <article class="process-step">
          <span>01</span>
          <h3>选择适合自己的版本</h3>
          <p>根据使用频率、任务复杂度和是否需要开发工作流，先判断 Plus、Pro 或 Codex 是否适合你。</p>
        </article>
        <article class="process-step highlighted-step">
          <span>02</span>
          <h3>前往订阅中心</h3>
          <p>已经确认订阅或升级需求后，可以进入订阅中心处理下一步。</p>
          <a class="btn btn-primary" href={siteConfig.site.conversionUrl} target="_blank" rel="noopener noreferrer">订阅 / 升级</a>
        </article>
        <article class="process-step">
          <span>03</span>
          <h3>返回本站查看使用指南</h3>
          <p>订阅后继续查看使用指南、额度问题、故障排查和开发者教程，提高实际使用效率。</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section version-section">
    <div class="container">
      <div class="section-heading compact-heading">
        <div>
          <span class="eyebrow">Choose Plan</span>
          <h2>Plus、Pro、Codex 怎么选？</h2>
        </div>
        <p>不同版本适合不同强度的任务。先看人群和场景，再进入更完整的指南。</p>
      </div>
      <div class="version-grid">
        {versionCards.map((item) => (
          <article class="version-card">
            <span>{item.subtitle}</span>
            <h3>{item.title}</h3>
            <dl>
              <div>
                <dt>适合人群</dt>
                <dd>{item.audience}</dd>
              </div>
              <div>
                <dt>核心场景</dt>
                <dd>{item.scenario}</dd>
              </div>
            </dl>
            <a class="card-action" href={withBasePath(item.path)}>查看详细指南</a>
          </article>
        ))}
      </div>
      <div class="inline-cta">
        <div>
          <strong>已经确定版本？</strong>
          <span>有明确订阅或升级需求时，可以直接进入订阅中心。</span>
        </div>
        <a class="btn btn-primary" href={siteConfig.site.conversionUrl} target="_blank" rel="noopener noreferrer">订阅 / 升级</a>
      </div>
    </div>
  </section>

  <section class="section prep-section">
    <div class="container prep-grid">
      <div>
        <span class="eyebrow">Before Subscribe</span>
        <h2>订阅前建议先了解这些</h2>
        <p>订阅和升级之前，先做好账号、安全和版本判断，后续使用会顺很多。</p>
      </div>
      <div class="prep-list">
        {preparationNotes.map((item) => (
          <div class="prep-item"><span aria-hidden="true"></span><strong>{item}</strong></div>
        ))}
      </div>
    </div>
  </section>

  <section class="section guides-section">
    <div class="container">
      <div class="section-heading compact-heading">
        <div>
          <span class="eyebrow">Popular Guides</span>
          <h2>热门教程</h2>
        </div>
        <p>保留 SEO 内容站能力，围绕 ChatGPT、Plus / Pro、Codex 和故障排查持续扩展。</p>
      </div>
      <div class="guide-grid">
        {coreArticles.map((entry) => (
          <article class="guide-card">
            <span class="guide-category">{COLLECTION_LABELS[entry.collection]}</span>
            <h3><a href={contentPath(entry)}>{entry.data.title}</a></h3>
            <p>{entry.data.description}</p>
            <a class="card-action" href={contentPath(entry)}>阅读文章</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section faq-section">
    <div class="container faq-grid">
      <div>
        <span class="eyebrow">FAQ</span>
        <h2>常见问题</h2>
        <p>先回答高频问题，再把需要展开的内容交给专题文章处理。</p>
      </div>
      <div class="faq-list">
        {homeFaq.map((item) => (
          <details>
            <summary>{item.question}</summary>
            <p>{item.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="section final-cta-section">
    <div class="container final-cta">
      <div>
        <span class="eyebrow">Start</span>
        <h2>准备开始使用 ChatGPT 或 Codex？</h2>
        <p>如果已经确定适合自己的版本，可以直接进入订阅中心；如果还不确定，可以先查看版本对比指南。</p>
      </div>
      <div class="final-actions">
        <a class="btn btn-primary" href={siteConfig.site.conversionUrl} target="_blank" rel="noopener noreferrer">订阅 / 升级</a>
        <a class="btn btn-light" href={withBasePath('/comparisons/')}>查看版本对比</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .section {
    padding-block: 72px;
  }

  .hero {
    position: relative;
    isolation: isolate;
    min-height: clamp(520px, 76vh, 660px);
    overflow: hidden;
    background: #102920;
    color: white;
  }

  .hero::before,
  .hero::after {
    position: absolute;
    inset: 0;
    content: "";
    z-index: -2;
  }

  .hero::before {
    background: var(--hero-image) center/cover no-repeat;
    opacity: 0.44;
  }

  .hero::after {
    z-index: -1;
    background:
      linear-gradient(90deg, rgba(8, 25, 20, 0.94) 0%, rgba(8, 42, 32, 0.86) 48%, rgba(12, 62, 49, 0.62) 100%),
      linear-gradient(180deg, rgba(10, 30, 25, 0.08), rgba(10, 30, 25, 0.62));
  }

  .hero-grid {
    display: grid;
    min-height: inherit;
    grid-template-columns: minmax(0, 1fr);
    gap: 34px;
    align-items: center;
    padding-block: 76px 56px;
  }

  .hero-copy {
    max-width: 820px;
  }

  .hero-kicker {
    display: inline-flex;
    margin-bottom: 16px;
    color: #b8f0d5;
    font-size: 0.86rem;
    font-weight: 800;
  }

  .hero h1 {
    display: grid;
    gap: 4px;
    margin: 0;
    font-size: clamp(2.65rem, 7vw, 5.25rem);
    line-height: 1.04;
  }

  .hero p {
    max-width: 760px;
    margin: 22px 0 0;
    color: #e0eee7;
    font-size: clamp(1.02rem, 2.3vw, 1.24rem);
  }

  .hero-actions,
  .final-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 30px;
  }

  .btn {
    display: inline-flex;
    min-height: 46px;
    align-items: center;
    justify-content: center;
    padding: 10px 17px;
    border: 1px solid transparent;
    border-radius: 6px;
    font-weight: 780;
    text-decoration: none;
  }

  .btn-primary {
    background: var(--color-primary);
    color: white;
  }

  .btn-primary:hover {
    background: #066a4c;
    color: white;
  }

  .btn-light {
    border-color: #d8eee3;
    background: #f4fcf7;
    color: #075e43;
  }

  .btn-light:hover {
    border-color: white;
    background: white;
  }

  .btn-ghost {
    border-color: rgba(255, 255, 255, 0.54);
    color: white;
  }

  .btn-ghost:hover {
    background: rgba(255, 255, 255, 0.11);
  }

  .trust-list {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 22px 0 0;
    padding: 0;
    list-style: none;
  }

  .trust-list li {
    padding: 5px 9px;
    border: 1px solid rgba(255, 255, 255, 0.22);
    border-radius: 6px;
    color: #d9eee4;
    font-size: 0.86rem;
  }

  .hero-panel {
    display: grid;
    gap: 1px;
    max-width: 360px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.12);
    backdrop-filter: blur(12px);
  }

  .hero-panel div {
    display: grid;
    gap: 4px;
    padding: 16px 18px;
    background: rgba(255, 255, 255, 0.08);
  }

  .hero-panel span {
    color: #b8d8cb;
    font-size: 0.78rem;
  }

  .hero-panel strong {
    font-size: 1rem;
  }

  .compact-heading {
    align-items: start;
  }

  .center-heading {
    display: grid;
    justify-items: center;
    text-align: center;
  }

  .quick-section,
  .version-section,
  .final-cta-section {
    background: white;
  }

  .quick-grid,
  .advantage-grid,
  .process-grid,
  .version-grid,
  .guide-grid {
    display: grid;
    gap: 18px;
  }

  .quick-card,
  .advantage-card,
  .process-step,
  .version-card,
  .guide-card {
    min-width: 0;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    background: white;
  }

  .quick-card {
    display: grid;
    gap: 22px;
    align-content: start;
    padding: 26px;
  }

  .quick-card h3,
  .advantage-card h3,
  .process-step h3,
  .version-card h3,
  .guide-card h3 {
    margin: 0;
    line-height: 1.32;
  }

  .quick-card p,
  .advantage-card p,
  .process-step p,
  .guide-card p,
  .prep-grid p,
  .faq-grid p,
  .final-cta p,
  .inline-cta span {
    color: var(--color-muted);
  }

  .quick-card p,
  .advantage-card p,
  .process-step p,
  .guide-card p {
    margin: 10px 0 0;
  }

  .card-action {
    color: var(--color-secondary);
    font-weight: 780;
    text-decoration: none;
  }

  .card-action:hover {
    text-decoration: underline;
  }

  .hot-links {
    padding-top: 18px;
    border-top: 1px solid var(--color-border);
  }

  .hot-links span {
    display: block;
    margin-bottom: 8px;
    color: var(--color-primary);
    font-size: 0.8rem;
    font-weight: 800;
  }

  .hot-links ul {
    display: grid;
    gap: 7px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .hot-links a {
    color: var(--color-muted);
    text-decoration: none;
  }

  .hot-links a:hover {
    color: var(--color-primary);
  }

  .advantages-section,
  .prep-section {
    background: #eef4f0;
  }

  .advantage-card {
    padding: 24px;
  }

  .icon {
    display: grid;
    width: 42px;
    height: 42px;
    margin-bottom: 18px;
    place-items: center;
    border-radius: 8px;
    background: #e4f4ec;
    color: var(--color-primary);
    font-weight: 820;
  }

  .process-section {
    background: #f7faf8;
  }

  .process-step {
    display: grid;
    gap: 12px;
    padding: 24px;
  }

  .process-step > span {
    color: var(--color-primary);
    font-size: 0.92rem;
    font-weight: 820;
  }

  .process-step p {
    margin: 0;
  }

  .highlighted-step {
    border-color: color-mix(in srgb, var(--color-primary) 45%, var(--color-border));
    background: #f0faf5;
  }

  .highlighted-step .btn {
    width: fit-content;
    margin-top: 4px;
  }

  .version-card {
    display: grid;
    gap: 18px;
    padding: 24px;
  }

  .version-card > span,
  .guide-category {
    color: var(--color-primary);
    font-size: 0.8rem;
    font-weight: 820;
  }

  .version-card dl {
    display: grid;
    gap: 14px;
    margin: 0;
  }

  .version-card dt {
    color: var(--color-text);
    font-size: 0.82rem;
    font-weight: 820;
  }

  .version-card dd {
    margin: 4px 0 0;
    color: var(--color-muted);
  }

  .inline-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 18px;
    align-items: center;
    justify-content: space-between;
    margin-top: 22px;
    padding: 22px;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    background: #f7faf8;
  }

  .inline-cta div {
    display: grid;
    gap: 4px;
