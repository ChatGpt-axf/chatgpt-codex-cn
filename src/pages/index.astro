---
import BaseLayout from '../layouts/BaseLayout.astro';
import { organizationSchema, webPageSchema, websiteSchema } from '../seo/schema';

const title = 'gptaixufei.com - 内容整理中';
const description = '本站原有内容已清空，后续将根据新的主题定位、栏目结构和文章计划重新上线。';
const schemas: Array<Record<string, unknown>> = [
  websiteSchema(),
  organizationSchema(),
  webPageSchema({ title, description, path: '/' }),
];
---

<BaseLayout title={title} description={description} canonicalPath="/" noindex={true} schema={schemas}>
  <section class="empty-home">
    <div class="empty-panel">
      <span class="eyebrow">gptaixufei.com</span>
      <h1>内容整理中</h1>
      <p>当前独立站内容已清空，后续会根据新的主题定位、栏目结构和文章计划重新上线。</p>
    </div>
  </section>
</BaseLayout>

<style>
  .empty-home {
    display: grid;
    min-height: 62vh;
    place-items: center;
    padding: 64px 20px;
    background: linear-gradient(180deg, #f7faf8 0%, #ffffff 100%);
  }

  .empty-panel {
    width: min(100%, 720px);
    padding: 42px;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    background: white;
    text-align: center;
  }

  .empty-panel h1 {
    margin: 10px 0 14px;
    font-size: clamp(2rem, 6vw, 3.6rem);
    line-height: 1.12;
  }

  .empty-panel p {
    margin: 0;
    color: var(--color-muted);
    font-size: 1.05rem;
  }

  @media (max-width: 640px) {
    .empty-panel {
      padding: 30px 22px;
    }
  }
</style>
