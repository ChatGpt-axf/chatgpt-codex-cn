---
import PillarLanding from '../components/PillarLanding.astro';
---

<PillarLanding
  title="AI 工具中文教程与选择指南"
  description="按真实任务组织 AI 工具教程、能力边界、版本对比和问题解决内容，不以工具数量代替信息价值。"
  path="/ai-tools/"
  eyebrow="AI Tools Pillar"
  directAnswer="AI 工具应按要完成的任务、输入数据、输出风险和验证成本来选择。本主题中心优先整理能够独立回答问题的教程与对比，并明确产品能力会变化的部分。"
  takeaways={[
    '先定义任务，再比较工具，不从热门功能反推需求。',
    '重要输出必须保留来源、人工复核和可回退流程。',
    '避免把宣传描述、模型排名或短期权益当作长期事实。',
  ]}
  sections={[
    { title: '内容组织方式', body: '每个工具主题连接基础概念、使用教程、方案对比和故障排查，形成可继续阅读的 Topic Cluster，而不是孤立模板页面。' },
    { title: '评估维度', body: '重点比较任务适配度、数据边界、结果可验证性、连续使用成本和当前官方支持情况。' },
  ]}
  links={[
    { title: 'ChatGPT 主题中心', description: '对话、写作、分析和核验方法。', path: '/chatgpt/' },
    { title: 'Codex 主题中心', description: '代理式软件开发与仓库工作流。', path: '/codex/' },
    { title: '产品对比', description: '按统一维度比较方案和能力边界。', path: '/comparisons/' },
    { title: '核心概念', description: '理解 AI 产品和代理工具中的关键术语。', path: '/concepts/' },
  ]}
/>
