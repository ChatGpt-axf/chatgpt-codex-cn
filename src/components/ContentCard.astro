---
import type { AnyContentEntry } from '../utils/content';
import { COLLECTION_LABELS, contentPath, formatDate } from '../utils/content';
import { siteConfig } from '../config/site';

interface Props { entry: AnyContentEntry }
const { entry } = Astro.props;
---

<article class="content-card">
  <div class="card-meta">
    <span>{COLLECTION_LABELS[entry.collection]}</span>
    <time datetime={entry.data.updated.toISOString()}>{formatDate(entry.data.updated, siteConfig.site.language)}</time>
  </div>
  <h3><a href={contentPath(entry)}>{entry.data.title}</a></h3>
  <p>{entry.data.description}</p>
  <a class="text-link" href={contentPath(entry)} aria-label={`阅读：${entry.data.title}`}>阅读全文 <span aria-hidden="true">→</span></a>
</article>
